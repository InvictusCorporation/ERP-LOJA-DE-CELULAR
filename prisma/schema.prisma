generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}
// Domain tables and RLS are defined in the SQL migration. Raw parameterized
// queries keep tenant context and ledger operations in the same transaction.
model Tenant {
  id String @id @db.Uuid
  name String
  slug String @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@map("tenants")
}
