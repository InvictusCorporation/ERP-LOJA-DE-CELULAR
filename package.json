{
  "name": "invictus-erp-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.server.json && node dist/scripts/dev.js",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "tsx --tsconfig tsconfig.server.json watch src/server/main.ts",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "node dist/scripts/start.js",
    "test": "tsc -p tsconfig.server.json && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "tsc -p tsconfig.server.json && node dist/scripts/backup.js",
    "db:restore": "tsc -p tsconfig.server.json && node dist/scripts/restore.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
