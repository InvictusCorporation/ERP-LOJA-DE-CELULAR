# Local PostgreSQL-compatible persistent database. Never use embedded mode for production.
DB_MODE=embedded
DATA_DIR=.data/invictus
PORT=4000
APP_ORIGIN=http://localhost:3000
# Production: DB_MODE=postgres, configure both URLs. Migration user owns tables;
# runtime role must be invictus_app (non-owner, no BYPASSRLS).
# DATABASE_URL=postgresql://invictus_app:PASSWORD@localhost:5432/invictus
# MIGRATION_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/invictus
# Fiscal vault, production: inject a random 32-byte key as 64 hex characters.
# Keep it in the server secret manager, separate from database backups. Never commit a real key.
# FISCAL_ENCRYPTION_KEY=
